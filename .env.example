# Crea un bot con @BotFather e inserisci qui il token.
TELEGRAM_BOT_TOKEN=

# Impostazioni opzionali
DATABASE_PATH=./data/bot.sqlite3
POLL_INTERVAL_SECONDS=300
TIMEZONE=Europe/Rome

# Recap automatico: abilita e scegli il giorno/ora locale (Europe/Rome).
AUTO_MONTHLY_RECAP=false
MONTHLY_RECAP_DAY=1
MONTHLY_RECAP_HOUR=9
